# ============================================
# 4. DATACLASSES (3.7+) - înlocuiesc clase boilerplate
# ============================================
# VECHI - mult cod scris de mână
class CustomerOld:
    def __init__(self, name: str, age: int, city: str):
        self.name = name
        self.age = age
        self.city = city
    
    def __repr__(self):
        return f"Customer({self.name}, {self.age}, {self.city})"
    
    def __eq__(self, other):
        return self.name == other.name and self.age == other.age

# MODERN - 3 linii fac tot
from dataclasses import dataclass, field

@dataclass
class Customer:
    name: str
    age: int
    city: str = "București"  # default value
    tags: list[str] = field(default_factory=list)  # mutable default - corect
    
c1 = Customer("Ana", 35, "Cluj")
c2 = Customer("Ana", 35, "Cluj")
print(c1)              # Customer(name='Ana', age=35, city='Cluj', tags=[])
print(c1 == c2)         # True - egalitate gratuită!


# ============================================
# 5. PATHLIB (înlocuiește os.path)
# ============================================
# VECHI
import os
file_path = os.path.join("data", "raw", "sales.csv")
if os.path.exists(file_path):
    pass

# MODERN
from pathlib import Path
file_path = Path("data") / "raw" / "sales.csv"
if file_path.exists():
    print(file_path.stem)        # 'sales' (fără extensie)
    print(file_path.suffix)      # '.csv'
    print(file_path.parent)      # 'data/raw'


# ============================================
# 6. STRUCTURAL PATTERN MATCHING (3.10+) 
# ============================================
def classify_response(status: int) -> str:
    match status:
        case 200 | 201 | 204:
            return "success"
        case 400 | 401 | 403:
            return "client_error"
        case status if 500 <= status < 600:
            return "server_error"
        case _:
            return "unknown"

# Chiar mai puternic - matching pe structuri
def process_event(event: dict) -> str:
    match event:
        case {"type": "purchase", "amount": amount} if amount > 1000:
            return f"big_purchase: {amount}"
        case {"type": "purchase", "amount": amount}:
            return f"purchase: {amount}"
        case {"type": "refund", **rest}:
            return f"refund with {rest}"
        case _:
            return "other"


