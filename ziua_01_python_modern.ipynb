# ============================================
# Refă funcția asta veche cu sintaxa modernă:

def calculate_discount_old(customer_data, purchase_amount):
    if customer_data is None:
        return None
    if customer_data.get("type") == "premium":
        if purchase_amount > 1000:
            return purchase_amount * 0.20
        else:
            return purchase_amount * 0.10
    elif customer_data.get("type") == "regular":
        return purchase_amount * 0.05
    else:
        return 0
