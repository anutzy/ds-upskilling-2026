# ============================================
# 1. F-STRINGS AVANSATE (3.6+, dar features 3.8+)
# ============================================
nume = "Ana"
salariu = 8500.50
ora = 14

# Format basic - îl știi
print(f"{nume} câștigă {salariu} RON")

# Format cu specificator (probabil nu folosești)
print(f"{salariu:,.2f} RON")  # 8,500.50 RON
print(f"{salariu:>15,.2f}")    # padded right
print(f"{ora:02d}:00")          # 14:00

# Self-documenting expressions (3.8+) - SUPER UTIL pentru debug
x = 42
print(f"{x=}")  # printează: x=42
print(f"{salariu * 12=:,.2f}")  # salariu * 12=102,006.00


